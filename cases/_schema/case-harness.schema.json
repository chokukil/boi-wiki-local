{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boi-local-case-harness/v1",
  "type": "object",
  "required": [
    "schema", "case_id", "title", "category", "status", "version", "audience", "start_prompt",
    "logical_roles", "reviewer_role", "orchestration_pattern", "scale_modes", "required_skills",
    "optional_features", "fixture_policy", "expected_local_types", "direct_promotion_blocked_types",
    "direct_promotion_blocked_roles",
    "eval_prompt_count", "evaluation_protocol", "fixture_id", "runtime_contract",
    "runtime_manifest", "handoff_schema", "reference_gate", "domain_validation"
  ],
  "properties": {
    "schema": {"const": "boi-local-case-harness/v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "status": {"enum": ["community", "verified", "reference"]},
    "logical_roles": {"type": "array", "minItems": 4, "maxItems": 5, "uniqueItems": true},
    "reviewer_role": {"type": "string"},
    "scale_modes": {"type": "array", "contains": {"const": "single-agent"}, "minItems": 3},
    "fixture_policy": {"enum": ["synthetic-only", "public-only", "synthetic-or-public"]},
    "direct_promotion_blocked_types": {"type": "array", "minItems": 1, "uniqueItems": true},
    "direct_promotion_blocked_roles": {"type": "array", "minItems": 1, "uniqueItems": true},
    "eval_prompt_count": {"type": "integer", "minimum": 5},
    "evaluation_protocol": {"type": "string", "pattern": "^[a-z0-9-]+-eval/v2$"},
    "fixture_id": {"type": "string", "minLength": 1},
    "runtime_contract": {"const": "boi-local-case-runtime/v1"},
    "runtime_manifest": {"const": "runtime/runtime.yaml"},
    "handoff_schema": {"const": "cases/_schema/handoff.schema.json"},
    "reference_gate": {"type": "object"},
    "domain_validation": {"type": "boolean"}
  },
  "additionalProperties": true
}
