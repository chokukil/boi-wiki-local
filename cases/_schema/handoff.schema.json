{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boi-local-case-handoff/v1",
  "title": "BoI Local Case role handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema",
    "case_id",
    "run_id",
    "phase",
    "from_role",
    "to_role",
    "local_only",
    "source_refs",
    "generated_from",
    "input_refs",
    "output_files",
    "supported_claims",
    "counterevidence",
    "unknowns",
    "contradictions",
    "blockers",
    "review_questions",
    "phase_exit",
    "source_integrity"
  ],
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "sha256"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "artifact_kind": {"const": "handoff"},
    "schema": {"const": "boi-local-case-handoff/v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "from_role": {"type": "string", "minLength": 1},
    "to_role": {"type": "string", "minLength": 1},
    "local_only": {"const": true},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
    "generated_from": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
    "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}},
    "output_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}},
    "supported_claims": {"type": "array", "items": {"type": "string"}},
    "counterevidence": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "review_questions": {"type": "array", "items": {"type": "string"}},
    "phase_exit": {"type": "string", "minLength": 1},
    "source_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_manifest_sha256", "after_manifest_sha256", "changed_source_files"],
      "properties": {
        "before_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "after_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_source_files": {"type": "array", "maxItems": 0}
      }
    }
  }
}
