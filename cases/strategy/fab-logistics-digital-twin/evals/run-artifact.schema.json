{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boi-local-case-run-artifact/v2",
  "title": "fab-logistics-digital-twin frozen run evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "protocol_revision",
    "prompt_id",
    "runtime",
    "runtime_version",
    "model_id",
    "reasoning_setting",
    "configuration",
    "repetition",
    "started_at",
    "finished_at",
    "duration_seconds",
    "execution_environment",
    "workspace_commit",
    "harness_release",
    "harness_checksum",
    "fixture_manifest_sha256",
    "seed_manifest_sha256",
    "user_prompt_sha256",
    "interaction_script_sha256",
    "runtime_envelope_sha256",
    "evaluated_interaction_sha256",
    "runtime_policy_sha256",
    "isolation",
    "tool_evidence",
    "source_integrity",
    "output_bundle",
    "remote_activity",
    "model_context",
    "assertions",
    "rubric",
    "evaluator"
  ],
  "properties": {
    "schema": {
      "const": "boi-local-case-run-artifact/v2"
    },
    "case_id": {
      "const": "fab-logistics-digital-twin"
    },
    "protocol_revision": {
      "const": "case-eval/v2"
    },
    "prompt_id": {
      "pattern": "^p0[1-5]$"
    },
    "runtime": {
      "enum": [
        "codex",
        "claude"
      ]
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_setting": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "enum": [
        "with-harness",
        "baseline"
      ]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "os_version",
        "runtime_transport",
        "workspace_kind",
        "sandbox_mode",
        "effective_workspace_write",
        "unsandboxed_synthetic_pilot"
      ],
      "properties": {
        "os": {
          "const": "windows-native"
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_transport": {
          "enum": [
            "desktop-app",
            "windows-cli"
          ]
        },
        "workspace_kind": {
          "const": "isolated-temporary-copy"
        },
        "sandbox_mode": {
          "const": "workspace-write"
        },
        "effective_workspace_write": {
          "const": true
        },
        "unsandboxed_synthetic_pilot": {
          "const": false
        }
      }
    },
    "workspace_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "harness_release": {
      "type": "string",
      "minLength": 1
    },
    "harness_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixture_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interaction_script_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluated_interaction_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_workspace",
        "cross_run_files_visible",
        "baseline_contract_sha256",
        "baseline_exposure_files"
      ],
      "properties": {
        "fresh_workspace": {
          "const": true
        },
        "cross_run_files_visible": {
          "const": false
        },
        "baseline_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_exposure_files": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "tool_evidence": {
      "type": "object",
      "required": [
        "allowed",
        "used",
        "network_enabled"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network_enabled": {
          "const": false
        }
      }
    },
    "source_integrity": {
      "type": "object",
      "required": [
        "before_manifest_sha256",
        "after_manifest_sha256",
        "selected_input_manifest_sha256_before",
        "selected_input_manifest_sha256_after",
        "selected_input_count",
        "changed_source_files"
      ],
      "properties": {
        "before_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "after_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_input_manifest_sha256_before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_input_manifest_sha256_after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_input_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_source_files": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "output_bundle": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "remote_activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp_writes",
        "remote_submits",
        "boi_remote_source_bytes"
      ],
      "properties": {
        "mcp_writes": {
          "const": 0
        },
        "remote_submits": {
          "const": 0
        },
        "boi_remote_source_bytes": {
          "const": 0
        }
      }
    },
    "model_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "runtime",
        "synthetic_evaluation",
        "selected_input_bytes",
        "data_classification",
        "user_authorized_runtime_processing"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "runtime": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "synthetic_evaluation": {
          "const": true
        },
        "selected_input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "data_classification": {
          "const": "synthetic"
        },
        "user_authorized_runtime_processing": {
          "const": true
        }
      }
    },
    "assertions": {
      "type": "object",
      "minProperties": 12,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "passed",
          "method",
          "evidence"
        ],
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "method": {
            "enum": [
              "deterministic",
              "reviewer"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": [
        "score",
        "dimensions"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dimensions": {
          "type": "object",
          "minProperties": 6
        }
      }
    },
    "evaluator": {
      "type": "object",
      "required": [
        "evaluator_id",
        "evaluator_version",
        "independent_from_runtime",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "evaluator_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "independent_from_runtime": {
          "const": true
        },
        "evidence_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
